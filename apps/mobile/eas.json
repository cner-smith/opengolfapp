{
  "cli": {
    "version": ">= 18.8.1",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "node": "24.22.2",
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "simulator": false
      },
      "env": {
        "npm_config_legacy_peer_deps": "true"
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "node": "24.22.2",
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "simulator": false
      },
      "env": {
        "npm_config_legacy_peer_deps": "true"
      }
    },
    "simulator": {
      "extends": "preview",
      "environment": "preview",
      "ios": {
        "simulator": true,
        "image": "macos-sequoia-15.6-xcode-26.2"
      }
    },
    "production": {
      "autoIncrement": true,
      "channel": "production",
      "node": "24.22.2",
      "ios": {
        "image": "macos-sequoia-15.6-xcode-26.2"
      },
      "env": {
        "npm_config_legacy_peer_deps": "true"
      }
    },
    "production-android": {
      "extends": "production",
      "buildArtifactPaths": [
        "android/app/build/outputs/mapping/release/mapping.txt"
      ]
    }
  },
  "submit": {
    "production": {}
  }
}
