VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Public Mapbox token, URL-restricted to the web domains (it ships in the JS
# bundle). Mobile uses its OWN, separate public token — don't share one.
VITE_MAPBOX_TOKEN=
VITE_TURNSTILE_SITE_KEY=

# Ops dashboard against production (pnpm dev:admin -> /dev/admin).
# Put the PROD SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY in .env.adminprod.local
# (gitignored). NOTE: this mode also points the Course Editor's write endpoints
# at production — the dashboard's red banner is the only thing warning you.
